'aloh+2'
'al(oh)2+'
'al(oh)3aq'
'al(oh)4-'
'alh3sio4+2'
'cacl+'
'caco3aq'
'cahco3+'
'caoh+'
'hco3-'
'h2co3aq'
'h2sio4-2'
