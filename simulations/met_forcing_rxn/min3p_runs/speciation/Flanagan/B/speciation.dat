'global control parameters'
'Speciation to determine initial and boundary conditions'
.false.                       ;varsat_flow
.false.                       ;steady_flow
.false.                       ;fully_saturated
.false.                       ;reactive_transport

'done'

! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
!
'geochemical system'

'compute alkalinity'

'use new database format'

'database directory'
'../../../../../databases'

'define temperature'
20.0

'components'
9                             ;number of components (nc-1)
'h+1'                         ;component names
'co3-2'
'mg+2'
'ca+2'
'na+1'
'k+1'
'al+3'
'h4sio4'
'cl-1'

