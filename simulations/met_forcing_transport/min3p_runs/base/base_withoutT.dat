! spinup.dat
!
! Data Block 1: global control parameters
! ---------------------------------------------------------------------------
!
'global control parameters'
'Spinup to test impact of forcing resolution on transport'
.true.                        ;varsat_flow
.false.                       ;steady_flow
.false.                       ;fully_saturated
.true.                        ;reactive_transport

'done'

! Data Block 2: geochemical system
! ---------------------------------------------------------------------------
!
'geochemical system'

'compute alkalinity'

'use new database format'

'database directory'
'../../../../databases'

'components'
2                             ;number of components (nc-1)
'psi01'                       ;component names
'psi02'                       ;component names

'done'

! Data Block 3: spatial discretization
! ---------------------------------------------------------------------------
!
'spatial discretization'
1                             ;number of discretization intervals in x
1                             ;number of control volumes in x
0.0 1.0                       ;xmin,xmax
1                             ;number of discretization intervals in y
1                             ;number of control volumes in y
0.0 1.0                       ;ymin,ymax
1                             ;number of discretization intervals in z
401                           ;number of control volumes in z
0.0 4.0                       ;zmin,zmax

'done'

! Data Block 4: time step control - global system
! ---------------------------------------------------------------------------
!
'time step control - global system'
'days'                        ;time unit
0.0                           ;time at start of solution
3650.0                        ;final solution time
1.0                           ;maximum time step
0.00001                       ;minimum time step

'done'

! Data Block 5: control parameters - local geochemistry
! ---------------------------------------------------------------------------
!
'control parameters - local geochemistry'

'newton iteration settings'
1.0d-4                        ;factor for numerical differentiation
1.0d-6                        ;convergence tolerance

'maximum ionic strength'
5.0d0                         ;max. ionic strength

'minimum activity for h2o'
0.5d0                         ;min. activity for h2o

'output time unit'
'days'                        ;time unit (local chemistry)

'done'

! Data Block 6: control parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'control parameters - variably saturated flow'

'mass balance'

'input units for boundary and initial conditions'
'pressure head'              ;input unit

'compute underrelaxation factor'
0.1                           ;maximum allowed update

'newton iteration settings'
1.0d-6                        ;increment for numerical differentiation
100                           ;maxit_vs, max. number of newton iterations
1.0d-6                        ;tol_vs, convergence tolerance
0.1                           ;sw_star

'solver settings'
0                             ;level_vs, incomplete factorization level
100                           ;msolvit_vs, max. number of solver iterations
1                             ;idetail_vs, solver information level
1.0d-7                        ;restol_vs, solver residual tolerance
1.0d-7                        ;deltol_vs, solver update tolerance

'done'

! Data Block 7: control parameters - reactive transport
! ---------------------------------------------------------------------------
!
'control parameters - reactive transport'

'mass balance'

'spatial weighting'
'upstream'                    ;spatial weighting

'activity update settings'
'time_lagged'                 ;type of activity update

'tortuosity correction'
'millington'

'newton iteration settings'
1.0d-4                        ;increment h for numerical differentiation
12                            ;anticipted number of Newton iterations
20                            ;max. number of Newton iterations
0.5d0                         ;anticipated update in log cycles
1.0d0                         ;maximum update in log cycles
1.0d-6                        ;convergence tolerance (global system)

'solver settings'
0                             ;incomplete factorization level
100                           ;max. number of solver iterations
1                             ;solver information level
1.0d-7                        ;solver residual tolerance
1.0d-7                        ;solver update tolerance

'done'

! Data Block 8: output control
! ---------------------------------------------------------------------------
!
'output control'

'output of spatial data'
14                             ;number of output times (spatial data)
10.0      30.0    90.0   180.0 ;specified output times (spatial data)
365.0    730.0  1095.0  1460.0 ;specified output times (spatial data)
1825.0  2190.0  2555.0  2920.0 ;specified output times (spatial data)
3285.0  3650.0                 ;specified output times (spatial data)

'output of transient data'
8                               ;number of output locations (transient data)
1                               ;timesteps between output (transient data)
400 396 391 371                 ;control volume numbers for transient data
351 301 201 101                 ;396=5 cm, 391=10 cm, 371=30 cm, 351=50 cm

'done'

! Data Block 9: physical parameters - porous medium
! ---------------------------------------------------------------------------
!
'physical parameters - porous medium'
3                             ;number of property zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'A horizon'
0.3800                        ;porosity

'extent of zone'
0.0 1.0  0.0 1.0  3.82 4.00

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'B horizon'
0.4348                        ;porosity

'extent of zone'
0.0 1.0  0.0 1.0  2.78 3.82

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
3
'C horizon'
0.3996                        ;porosity

'extent of zone'
0.0 1.0  0.0 1.0  0.00 2.78

'end of zone'

'done'

! Data Block 10: physical parameters - variably saturated flow
! ---------------------------------------------------------------------------
!
'physical parameters - variably saturated flow'

! ---------------------------------------------------------------------------
'A horizon'

'hydraulic conductivity in z-direction'
2.048d-1                      ;K_zz (m/s)

'specific storage coefficient'
0.0                           ;S_s

'soil hydraulic function parameters'
0.1780                        ;residual saturation (saturation [0,1], not water content [0, porosity])
1.7098                        ;van genuchten - alpha (1/m)
1.3661                        ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

! ---------------------------------------------------------------------------
'B horizon'

'hydraulic conductivity in z-direction'
2.048d-1                      ;K_zz (m/s)

'specific storage coefficient'
0.0                           ;S_s

'soil hydraulic function parameters'
0.1780                        ;residual saturation (saturation [0,1], not water content [0, porosity])
1.7098                        ;van genuchten - alpha (1/m)
1.3661                        ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

! ---------------------------------------------------------------------------
'C horizon'

'hydraulic conductivity in z-direction'
2.048d-1                      ;K_zz (m/s)

'specific storage coefficient'
0.0                           ;S_s

'soil hydraulic function parameters'
0.1780                        ;residual saturation (saturation [0,1], not water content [0, porosity])
1.7098                        ;van genuchten - alpha (1/m)
1.3661                        ;van genuchten - n
0.5                           ;expn
0.0                           ;air entry pressure

'end of zone'

'done'

! Data Block 11: physical parameters - reactive transport
! ---------------------------------------------------------------------------
!
'physical parameters - reactive transport'
'diffusion coefficients'
0.0d0                         ;diffusion coefficient
0.0d0

! ---------------------------------------------------------------------------
'A horizon'
'longitudinal dispersivity'
0.0d0                         ;dispersivity
'transverse vertical dispersivity'
0.0d0                         ;dispersivity
'end of zone'

! ---------------------------------------------------------------------------
'B horizon'
'longitudinal dispersivity'
0.0d0                         ;dispersivity
'transverse vertical dispersivity'
0.0d0                         ;dispersivity
'end of zone'

! ---------------------------------------------------------------------------
'C horizon'
'longitudinal dispersivity'
0.0d0                         ;dispersivity
'transverse vertical dispersivity'
0.0d0                         ;dispersivity
'end of zone'

'done'

! Data Block 12: initial condition - variably saturated flow
! ---------------------------------------------------------------------------
!
'initial condition - variably saturated flow'
1                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'all domain'

'extent of zone'
0.0 1.0  0.0 1.0  0.0 4.0

'initial condition'
0.0                           ;initial pressure head (m)

'end of zone'

'done'

! Data Block 13: boundary conditions - variably saturated flow
! ---------------------------------------------------------------------------
!
'boundary conditions - variably saturated flow'
2                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'inflow boundary - top'

'boundary type'
'second'  1.5761d-7           ;flux (m/s)

'extent of zone'
0.0 1.0  0.0 1.0  4.0 4.0

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'outflow boundary - bottom'

'boundary type'
'first'   0.0                  ;pressure head [m]

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.0

'end of zone'

'done'

! Data Block 15: initial condition - reactive transport
! ---------------------------------------------------------------------------
!
'initial condition - reactive transport'
1                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'background concentrations'

'concentration input'
1.0000d-3      'free'         ;'tracer - psi01'
1.0000d-3      'free'         ;'tracer - psi02'

'extent of zone'
0.0 1.0  0.0 1.0  0.0 4.0     ;extent of zone

'end of zone'

'done'

! Data Block 16: boundary conditions - reactive transport
! ---------------------------------------------------------------------------
!
'boundary conditions - reactive transport'
2                             ;number of zones

! ---------------------------------------------------------------------------
'number and name of zone'
1
'top boundary'

'boundary type'
'third'

'concentration input'
1.0000d-1      'free'         ;'tracer - psi01'
1.0000d-3      'free'         ;'tracer - psi02'

'extent of zone'
0.0 1.0  0.0 1.0  4.0 4.0

'end of zone'

! ---------------------------------------------------------------------------
'number and name of zone'
2
'bottom boundary'

'boundary type'
'third'

'concentration input'
1.0000d-3      'free'         ;'tracer - psi01'
1.0000d-3      'free'         ;'tracer - psi02'

'extent of zone'
0.0 1.0  0.0 1.0  0.0 0.0

'end of zone'

'done'
